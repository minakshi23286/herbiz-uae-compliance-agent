{
 "$id": "https://herbiz.invalid/contracts/source_validity_1.2.schema.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "allOf": [
  {
   "if": {
    "properties": {
     "status": {
      "const": "conflict"
     }
    },
    "required": [
     "status"
    ]
   },
   "then": {
    "properties": {
     "conflicts": {
      "minItems": 1
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "status": {
      "enum": [
       "outdated",
       "superseded"
      ]
     }
    },
    "required": [
     "status"
    ]
   },
   "then": {
    "properties": {
     "amendments": {
      "minItems": 1
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "current_official_url": {
      "type": "string"
     }
    },
    "required": [
     "current_official_url"
    ]
   },
   "then": {
    "properties": {
     "current_official_url_status": {
      "type": "object"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "current_official_url": {
      "type": "null"
     }
    },
    "required": [
     "current_official_url"
    ]
   },
   "then": {
    "properties": {
     "current_official_url_status": {
      "type": "null"
     }
    }
   }
  }
 ],
 "properties": {
  "amendments": {
   "items": {
    "additionalProperties": false,
    "properties": {
     "articles_affected": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "effective_date": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": [
       "string",
       "null"
      ]
     },
     "evidence_level": {
      "enum": [
       "observed",
       "observed_in_file",
       "observed_listing_only",
       "snippet_only",
       "supplied",
       "unresolved"
      ]
     },
     "instrument": {
      "minLength": 1,
      "type": "string"
     },
     "url": {
      "pattern": "^https://",
      "type": "string"
     }
    },
    "required": [
     "instrument",
     "effective_date",
     "articles_affected",
     "evidence_level",
     "url"
    ],
    "type": "object"
   },
   "type": "array"
  },
  "article": {
   "minLength": 1,
   "type": "string"
  },
  "conflicts": {
   "items": {
    "additionalProperties": false,
    "properties": {
     "claim": {
      "minLength": 1,
      "type": "string"
     },
     "conflict_id": {
      "minLength": 1,
      "type": "string"
     },
     "precedence_known": {
      "const": false
     },
     "resolution": {
      "const": "escalate"
     },
     "values": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "locator": {
         "minLength": 1,
         "type": "string"
        },
        "source_id": {
         "minLength": 1,
         "type": "string"
        },
        "url": {
         "pattern": "^https://",
         "type": "string"
        },
        "value": {
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "source_id",
        "url",
        "value",
        "locator"
       ],
       "type": "object"
      },
      "minItems": 2,
      "type": "array"
     }
    },
    "required": [
     "conflict_id",
     "claim",
     "values",
     "precedence_known",
     "resolution"
    ],
    "type": "object"
   },
   "type": "array"
  },
  "contract": {
   "const": "herbiz.source_validity/1.2"
  },
  "current_official_url": {
   "pattern": "^https://",
   "type": [
    "string",
    "null"
   ]
  },
  "current_official_url_status": {
   "additionalProperties": false,
   "properties": {
    "checked_on": {
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
     "type": [
      "string",
      "null"
     ]
    },
    "content_check": {
     "enum": [
      "pending_founder_verification",
      "founder_opened",
      "not_checked"
     ]
    },
    "link_status": {
     "enum": [
      "ok",
      "blocked_to_automation",
      "dead",
      "unchecked"
     ]
    }
   },
   "required": [
    "link_status",
    "checked_on",
    "content_check"
   ],
   "type": [
    "object",
    "null"
   ]
  },
  "key": {
   "pattern": "^[A-Za-z0-9_.-]+\\|.+$",
   "type": "string"
  },
  "link_checked_on": {
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
   "type": [
    "string",
    "null"
   ]
  },
  "link_status": {
   "enum": [
    "ok",
    "blocked_to_automation",
    "dead",
    "unchecked"
   ]
  },
  "release_approved": {
   "const": false
  },
  "reuse_terms": {
   "additionalProperties": false,
   "properties": {
    "note": {
     "type": "string"
    },
    "publisher_terms_url": {
     "pattern": "^https://",
     "type": [
      "string",
      "null"
     ]
    },
    "redistribution": {
     "enum": [
      "unknown",
      "link_only",
      "permitted"
     ]
    }
   },
   "required": [
    "publisher_terms_url",
    "redistribution",
    "note"
   ],
   "type": "object"
  },
  "review_status": {
   "enum": [
    "discovered",
    "candidate",
    "reviewed"
   ]
  },
  "snapshot_date": {
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
   "type": "string"
  },
  "source_id": {
   "minLength": 1,
   "type": "string"
  },
  "status": {
   "enum": [
    "current",
    "outdated",
    "superseded",
    "conflict",
    "not_collected",
    "unknown"
   ]
  }
 },
 "required": [
  "contract",
  "key",
  "source_id",
  "article",
  "status",
  "snapshot_date",
  "amendments",
  "current_official_url",
  "current_official_url_status",
  "conflicts",
  "link_status",
  "link_checked_on",
  "review_status",
  "reuse_terms",
  "release_approved"
 ],
 "title": "herbiz.source_validity/1.2",
 "type": "object"
}
